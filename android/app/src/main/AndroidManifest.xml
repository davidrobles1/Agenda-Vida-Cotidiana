<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AND-005: required on API 33+ to actually display a notification; fetching an
         FCM token itself does not need it, but a real push feature does. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VidaCotidianaApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.VidaCotidiana">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!--
              AND-002, found for real on a physical device: AppAuth's Custom Tabs
              redirect (via RedirectUriReceiverActivity -> back into MainActivity)
              was creating a NEW MainActivity instance instead of reusing the one
              the user was already on, orphaning that original instance (and the
              instrumented test's ComposeTestRule, bound to it) — clicks/text
              input kept "succeeding" against a UI no one could see or that no
              longer drove any live ViewModel. singleTask makes Android reuse the
              existing instance for that redirect instead of creating a new one.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
