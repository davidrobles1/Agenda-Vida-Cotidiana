# WEB-005: Firebase project vida-cotidiana-6da30. VITE_FIREBASE_API_KEY is a
# Firebase Web client key — public by design (always shipped to the browser),
# not a secret — but kept out of the repo like the rest of this file for
# clean separation of config from code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Console -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=

# WEB-006: GlitchTip (self-hosted, Sentry-protocol-compatible), local dev
# instance from docker-compose.yml (glitchtip-web, http://localhost:8000).
# Public DSN, safe to ship to the browser like any Sentry DSN — kept in .env
# for the same clean-separation reason as the Firebase keys above.
VITE_GLITCHTIP_DSN=
# Real bearer credential (unlike the DSN above) — generated via the
# one-time local setup under WEB-006 in 01-technical-backlog.md. Used only
# by web/e2e/error-tracking.spec.ts (Node/Playwright process), never
# bundled into the browser build.
GLITCHTIP_API_TOKEN=
