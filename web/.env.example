# WEB-005: Firebase project vida-cotidiana-6da30. VITE_FIREBASE_API_KEY is a
# Firebase Web client key — public by design (always shipped to the browser),
# not a secret — but kept out of the repo like the rest of this file for
# clean separation of config from code.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Console -> Cloud Messaging -> Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
