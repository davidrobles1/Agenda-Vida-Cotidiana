<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Vida Cotidiana</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vidacotidiana.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- IOS-002: ASWebAuthenticationSession callback scheme — must match
				     the ios-app Keycloak client's redirect_uri (Phase 1). -->
				<string>com.vidacotidiana.app</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- IOS-002/003, bootstrap only: plain HTTP is only ever needed to reach
		     the local dev backend/Keycloak — Simulator: localhost works directly
		     (unlike the Android emulator); physical device: the Mac's LAN IP,
		     which changes on DHCP renewal, so NSAllowsLocalNetworking (any
		     private-network host, iOS 10+) is used instead of a hardcoded
		     NSExceptionDomains entry that would go stale. Remove/scope this
		     before any real release build — never shipped as-is. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
</dict>
</plist>
